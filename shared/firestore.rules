rules_version = '2';

// One rule set for every app in this repo. Two tiers (shared/KIT-PLAN.md):
//
// - The household: signed in with Google AND your email has a document in /members. It
//   reaches /members and all of /sidequests/** except Rack It. The members list lives in Firestore, not in
//   this file, so the apps can manage it: adding a person (Rack It → More → Invites) takes
//   effect instantly, with no rules deploy and no email addresses in the public repo.
// - An account: anyone signed in, keyed by uid. It reaches /profiles, /invites and
//   /friendships, each as narrowly as below, and under /sidequests/ only Rack It's matches
//   it plays in, one rating at a time, and Rack It's config (Session 6).
//
// Rack It has no household tier (Session 6b): the owner is its one admin and sees everything;
// every other account, a household member included, is a player as above. Sessions Loyalty
// has none either: its staff list (and the owner) sees everything, and every other account,
// a household member included, is a member who reads only its own card and entries.
//
// The open apps (Session 7, openApps() below) work the same way for every app on the list: open
// to anyone signed in, each record reached only by the accounts in it, and the owner reaches all.
//
// Cost: making a friendship reads the invite with one get(). Every rule here has cases in
// shared/rules-check.mjs, written before the rule; a failing case stops the deploy.
//
// One member is the owner: their /members document carries role: "owner", set by hand in
// the Firebase console. Only the owner removes a member or changes a member's role, and
// only the owner does the things in Rack It that can't be undone (below).

service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email));
    }

    function isOwner() {
      return isFamily()
        && get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.get('role', '') == 'owner';
    }

    // The allowlist. Any member invites (and re-invites, which only touches addedBy and
    // addedAt); nobody but the owner removes anyone or sets a role.
    match /members/{email} {
      allow read: if isFamily();
      allow create: if isFamily() && !request.resource.data.keys().hasAny(['role']);
      allow update: if isOwner()
        || (isFamily() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['addedBy', 'addedAt']));
      allow delete: if isOwner();
    }

    // Every app keeps its data under /sidequests/<appId>/... (people under _shared).
    // Rack It's and Sessions Loyalty's reads and writes are spelled out below instead, and so
    // are the open apps'.
    match /sidequests/{appId}/{document=**} {
      allow read: if isFamily() && !(appId in ['rack-it', 'sessions-loyalty']) && !isOpen(appId);
      allow write: if isFamily() && !(appId in ['rack-it', 'sessions-loyalty']) && !isOpen(appId);
    }

    // ---- The open rule (KIT-PLAN Session 7 step 4) ----
    // An app on this list, with the collection its records live in, is open to anyone signed in:
    // a stranger gets an empty app of their own. Each record names its players: `players` (ids,
    // at most 8), `names`, `uids` (the accounts among them) and `by`. Only the accounts in `uids`
    // reach it, and the owner reaches everything. Starting one names only accounts you're
    // connected to; playing on never changes who's in it. A new app on the rule is one entry here.
    function openApps() { return { 'zombie-dice': 'games', 'around-the-clock': 'games', 'bloc-11': 'climbs' }; }
    function isOpen(appId) { return appId in openApps(); }
    match /sidequests/{appId}/{coll}/{id} {
      allow read: if isOpen(appId) && openApps()[appId] == coll
        && signedIn() && request.auth.uid in resource.data.get('uids', []);
      allow create: if isOpen(appId) && openApps()[appId] == coll && signedIn() && opens();
      allow update: if isOpen(appId) && openApps()[appId] == coll && signedIn()
        && request.auth.uid in resource.data.get('uids', []) && (keepsWho() || openClaim());
      allow delete: if isOpen(appId) && openApps()[appId] == coll && signedIn()
        && resource.data.get('by', '') == request.auth.uid;
    }
    match /sidequests/{appId}/{document=**} {
      allow read, write: if isOpen(appId) && isOwner();
    }
    // A new record: yours, with you in it, at most eight players, every other account in it one of
    // the players and someone you're connected to (unrolled: at most 7 exists()). You may be in it
    // without playing: a climb you log for your guest (Bloc 11) is still yours to read.
    function opens() {
      let r = request.resource.data;
      return r.keys().hasAll(['players', 'names', 'uids', 'by']) && r.by == request.auth.uid
        && r.players is list && r.players.size() <= 8 && r.uids is list && r.uids.size() <= 8
        && request.auth.uid in r.uids
        && seat(r, 0) && seat(r, 1) && seat(r, 2) && seat(r, 3) && seat(r, 4) && seat(r, 5) && seat(r, 6) && seat(r, 7);
    }
    function seat(r, i) {
      return r.uids.size() <= i || r.uids[i] == request.auth.uid
        || (r.uids[i] in r.players && connected(request.auth.uid, r.uids[i]));
    }
    function keepsWho() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uids', 'players', 'by']);
    }

    // ---- A guest's seat becomes an account's: seatSwap() (KIT-PLAN Session 8) ----
    // Exactly one player id that starts g_ becomes an account's uid, and `uids` gains exactly that
    // uid, appended. The newcomer is the last uid. `names` stays: it's who sat there then.
    function newcomer() { return request.resource.data.uids[request.resource.data.uids.size() - 1]; }
    function isGuest(id) { return id is string && id.matches('g_.*'); }
    function gainsOnly(x) {
      let was = resource.data.get('uids', []);
      return !(x in was) && request.resource.data.uids.size() == was.size() + 1
        && request.resource.data.uids.removeAll([x]) == was;
    }
    // In the open rule, seat by seat (unrolled, at most 8): unchanged, or the one guest seat that
    // became x. The score maps keyed by the guest's id may move with it, as any player may change
    // scores; who's in it may not, beyond the seat.
    function openSeat(x, i) {
      let was = resource.data.players;
      return was.size() <= i || request.resource.data.players[i] == was[i]
        || (request.resource.data.players[i] == x && isGuest(was[i]));
    }
    function openSwap() {
      let was = resource.data;
      let now = request.resource.data;
      let x = newcomer();
      return !now.diff(was).affectedKeys().hasAny(['by', 'names'])
        && gainsOnly(x) && !(x in was.players) && now.players.size() == was.players.size()
        && now.players.removeAll([x]).size() == was.players.size() - 1
        && openSeat(x, 0) && openSeat(x, 1) && openSeat(x, 2) && openSeat(x, 3)
        && openSeat(x, 4) && openSeat(x, 5) && openSeat(x, 6) && openSeat(x, 7);
    }
    // That was them (step 1): whoever started it gives a guest's seat to someone they're connected to.
    function openClaim() {
      return resource.data.get('by', '') == request.auth.uid && openSwap() && connected(request.auth.uid, newcomer());
    }

    // Rack It: one admin, everyone else a player (Session 6b). The owner reads and writes all of
    // it: lists every match, deletes or rewrites a saved one (which is what Rebuild ratings
    // does), sets starters and the config. A new collection here needs its own rule.
    //
    // Everyone else, household members included, is a player (Session 6): an account reads and
    // scores only the matches with its uid in `uids`, starts one only alone with a guest or
    // against someone it's connected to, and moves a rating only in the batch where it confirms
    // a rated match the other player ended. The rules can't check the arithmetic; the owner's
    // Rebuild ratings remakes every rating from the matches. The uid checks come first, so a
    // player's own writes cost no /members lookup.
    match /sidequests/rack-it/state/{doc} {
      allow get: if signedIn() && doc == 'main';   // the config; the ratings left it in Session 3
      allow write: if isOwner();
    }
    match /sidequests/rack-it/matches/{id} {
      allow read: if (signedIn() && (request.auth.uid in resource.data.get('uids', [])
          || resource.data.get('scorer', '') == request.auth.uid)) || isOwner();
      // A Game QR (Session 8): someone connected to the starter gets a live match, never a list.
      allow get: if signedIn() && resource.data.get('status', '') == 'live'
        && connected(request.auth.uid, resource.data.get('by', ''));
      allow create: if (signedIn() && (outsiderStarts() || scorerStarts())) || isOwner();
      allow update: if (signedIn() && request.auth.uid in resource.data.get('uids', []) && playerScores())
        || (signedIn() && resource.data.get('scorer', '') == request.auth.uid && scorerScores())
        || (signedIn() && (rackClaim() || takesSeat()))
        || (isOwner() && ownerKeepsChain());
      allow delete: if isOwner();
    }
    match /sidequests/rack-it/starters/{id} {
      allow read, write: if isOwner();
    }
    // Each player's rating, keyed by their resolved id (KIT-PLAN.md Session 3). A cache that
    // Rebuild ratings remakes from the matches. Anyone signed in gets one by its id; only the
    // owner lists them or writes one outside a confirmation.
    match /sidequests/rack-it/ratings/{pid} {
      allow get: if signedIn();
      allow list: if isOwner();
      allow write: if (signedIn() && (confirming(pid) || guestStarter(pid) || claimedStarter(pid))) || isOwner();
    }

    // Sessions Loyalty (sessions-loyalty/SPEC.md §6): a club's staff and its members. Staff are
    // the uids under staff/ (the owner alone writes that list) and the owner. Staff read and
    // write all of it: settings, rewards, ways to earn, every member's card, note and entries.
    // A member is any account: it reads the club's settings and items, its own card and its own
    // entries (listed with its uid filter), and writes nothing. The rules can't check the
    // points arithmetic; staff's Rebuild remakes every card from the entries. A household
    // member is a plain member here, as in Rack It.
    function isStaff() {
      return signedIn()
        && (exists(/databases/$(database)/documents/sidequests/sessions-loyalty/staff/$(request.auth.uid)) || isOwner());
    }
    match /sidequests/sessions-loyalty/settings/{doc} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
    match /sidequests/sessions-loyalty/staff/{uid} {
      allow get: if signedIn();      // "am I staff?": your own document, present or not
      allow list: if isStaff();
      allow write: if isOwner();
    }
    match /sidequests/sessions-loyalty/rewards/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
    match /sidequests/sessions-loyalty/earns/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
    match /sidequests/sessions-loyalty/cards/{uid} {
      allow get: if me(uid) || isStaff();
      allow list: if isStaff();
      allow write: if isStaff();
    }
    match /sidequests/sessions-loyalty/notes/{uid} {
      allow read, write: if isStaff();
    }
    // An entry is written once, by the staff member logging it, and only ever voided after
    // that. Deleting one is the owner's; so is creating one in someone else's name (Import).
    match /sidequests/sessions-loyalty/entries/{id} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isStaff();
      allow create: if (isStaff() && request.resource.data.by == request.auth.uid) || isOwner();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided', 'voidedBy', 'voidedAt', '_updatedAt']);
      allow delete: if isOwner();
    }

    // A match with no `rated` field is rated: every match before 2.9.0 moved ratings.
    function rated(m) { return m.get('rated', true) == true; }
    function ratedOnlyTurnsOff() { return !rated(request.resource.data) || rated(resource.data); }
    function connected(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(a < b ? a + '_' + b : b + '_' + a));
    }
    // A new match an outsider plays in: started by them, live, not yet ended, alone with a
    // guest or against someone they're connected to.
    function outsiderStarts() {
      let m = request.resource.data;
      return m.by == request.auth.uid && request.auth.uid in m.uids && m.status == 'live'
        && !m.keys().hasAny(['endedBy', 'confirmedBy', 'ratedAt', 'declinedBy', 'withdrawnBy', 'scorer', 'confirms'])
        && (m.uids.size() == 1 || (m.uids.size() == 2 && connected(m.uids[0], m.uids[1])));
    }
    // A player's write to a match they're in. Never who's in it. A live match is scored, saved
    // or discarded; going to pending stamps endedBy as yourself, and a rated match is never
    // finished from live. A pending match only finishes, touching only the confirmation's
    // fields: rated by a player who didn't end it (Confirm), or as a friendly (Not right,
    // Withdraw). rated only ever turns off.
    function playerScores() {
      let was = resource.data;
      let now = request.resource.data;
      let keys = now.diff(was).affectedKeys();
      return !keys.hasAny(['uids', 'by', 'playerA', 'playerB', 'names', 'scorer'])
        && ratedOnlyTurnsOff()
        && (was.status == 'live' ? liveScore(keys)
          : was.status == 'pending' && (now.status == 'pending' ? confirmsMine(keys)
            : now.status == 'done'
              && keys.hasOnly(['status', 'rated', 'zargoBefore', 'zargoAfter', 'ratedAt', 'confirmedBy',
                               'declinedBy', 'withdrawnBy', '_updatedAt'])
              // Someone else ended it (a match with no endedBy can't be confirmed), and every
              // other player who didn't end it has already confirmed (both sign, Session 8).
              && (!rated(now) || (request.auth.uid != was.get('endedBy', request.auth.uid) && othersConfirmed()))));
    }
    // A live match is scored link by link; going to pending stamps endedBy as yourself, and a
    // rated match is never finished from live. Players and the scorer alike.
    function liveScore(keys) {
      let was = resource.data;
      let now = request.resource.data;
      return (myPhone(keys) || nextLink())
        && now.status in ['live', 'pending', 'done', 'discarded']
        && (now.status == 'pending'
          ? now.get('endedBy', null) == request.auth.uid
          : now.get('endedBy', null) == was.get('endedBy', null))
        && !(now.status == 'done' && rated(now));
    }
    // Both sign (Session 8 step 4): on a pending match someone else ended, a player adds their
    // own key to confirms, and nothing else moves. The last player's Confirm is the batch.
    function confirmsMine(keys) {
      let was = resource.data.get('confirms', {});
      return keys.hasOnly(['confirms', '_updatedAt']) && request.auth.uid != resource.data.get('endedBy', request.auth.uid)
        && request.resource.data.confirms.keys().hasAll(was.keys())
        && request.resource.data.confirms.diff(was).affectedKeys().hasOnly([request.auth.uid]);
    }
    function othersConfirmed() {
      let was = resource.data;
      return was.get('confirms', {}).keys().hasAll(was.uids.removeAll([was.get('endedBy', ''), request.auth.uid]));
    }
    // The scorer (step 4): someone who isn't playing, named `scorer` by themselves when they
    // started it. Scores and ends it like a player; may Withdraw; never confirms.
    function scorerScores() {
      let was = resource.data;
      let now = request.resource.data;
      let keys = now.diff(was).affectedKeys();
      return !keys.hasAny(['uids', 'by', 'playerA', 'playerB', 'names', 'scorer', 'confirms'])
        && ratedOnlyTurnsOff()
        && (was.status == 'live' ? liveScore(keys)
          : was.status == 'pending' && now.status == 'done' && !rated(now)
            && keys.hasOnly(['status', 'rated', 'withdrawnBy', '_updatedAt']) && now.get('withdrawnBy', '') == request.auth.uid);
    }
    // A new match its starter scores without playing: live, not ended, the starter not in uids,
    // and connected to each player with an account (a guest needs none).
    function scorerStarts() {
      let m = request.resource.data;
      return m.get('scorer', '') == request.auth.uid && m.by == request.auth.uid && m.status == 'live'
        && m.uids is list && m.uids.size() <= 2 && !(request.auth.uid in m.uids)
        && !m.keys().hasAny(['endedBy', 'confirmedBy', 'ratedAt', 'declinedBy', 'withdrawnBy', 'confirms'])
        && (m.uids.size() < 1 || connected(request.auth.uid, m.uids[0]))
        && (m.uids.size() < 2 || connected(request.auth.uid, m.uids[1]));
    }
    // Two phones, one match (Session 8 step 3). A write to a live match's score is the next link
    // of a chain, rev: { n, key, was }: one more than the stored n, built on the stored key, with
    // a key of its own. A phone that was offline, or lost a race, built on a link that's gone, so
    // its queued writes are refused rather than rewinding the match (a counter alone isn't enough:
    // shared/proofs/rev-probe.mjs). A presence write touches only your own phones entry.
    function nextLink() {
      let was = resource.data.get('rev', {});
      let now = request.resource.data.get('rev', {});
      return now.get('n', -1) == was.get('n', 0) + 1 && now.get('was', null) == was.get('key', '')
        && now.get('key', '') is string && now.get('key', '') != '' && now.get('key', '') != was.get('key', '');
    }
    function myPhone(keys) {
      return keys.hasOnly(['phones', '_updatedAt'])
        && request.resource.data.phones.diff(resource.data.get('phones', {})).affectedKeys().hasOnly([request.auth.uid]);
    }
    // The owner rewrites anything, but a live match's score still goes link by link, so the
    // owner's own stale phone can't rewind it. A match from before 2.8.0 (no uids) is exempt, for
    // the backfill, and so is a seat changing hands.
    function ownerKeepsChain() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.get('status', '') != 'live' || !('uids' in resource.data)
        || myPhone(keys) || nextLink() || rackSwap();
    }
    // seatSwap() in Rack It: one side, a guest, becomes x, and nothing else in the match changes.
    function rackSwap() {
      let was = resource.data;
      let now = request.resource.data;
      let x = newcomer();
      return now.diff(was).affectedKeys().hasOnly(['playerA', 'playerB', 'uids', '_updatedAt']) && gainsOnly(x)
        && ((isGuest(was.playerA) && now.playerA == x && now.playerB == was.playerB)
          || (isGuest(was.playerB) && now.playerB == x && now.playerA == was.playerA));
    }
    // That was them: the starter gives a guest's seat to someone they're connected to.
    function rackClaim() {
      return resource.data.get('by', '') == request.auth.uid && rackSwap() && connected(request.auth.uid, newcomer());
    }
    // A Game QR seat (step 2): you take a guest's seat in a live match whose starter you're
    // connected to. A guest's match is a friendly, and rackSwap() keeps it one.
    function takesSeat() {
      return newcomer() == request.auth.uid && resource.data.status == 'live' && rackSwap()
        && connected(request.auth.uid, resource.data.get('by', ''));
    }
    // A rating moves only in the batch that confirms a rated match: pending before the batch,
    // done and still rated after it, and the rating a player in it. Who may confirm is the match
    // update's rule above, which has to pass in the same batch.
    function confirming(pid) {
      let path = /databases/$(database)/documents/sidequests/rack-it/matches/$(request.resource.data.match);
      let now = getAfter(path).data;
      return get(path).data.status == 'pending' && now.status == 'done' && rated(now) && pid in now.uids;
    }
    // A guest's starter estimate, written once by the account that made the guest.
    function guestStarter(pid) {
      return resource == null && exists(/databases/$(database)/documents/profiles/$(request.auth.uid)/guests/$(pid));
    }

    // That was them: a claimed guest's starter becomes the friend's, when the friend has no
    // rating. Written by the account whose guest it was, with the guest's numbers unchanged.
    function claimedStarter(pid) {
      let r = request.resource.data;
      let from = r.get('from', '');
      let g = get(/databases/$(database)/documents/sidequests/rack-it/ratings/$(from)).data;
      return resource == null && isGuest(from)
        && r.keys().hasOnly(['zargo', 'robustness', 'sessions', 'from', '_updatedAt'])
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)/guests/$(from)).data.get('claimedBy', '') == pid
        && connected(request.auth.uid, pid)
        && r.zargo == g.zargo && r.get('robustness', 0) == g.get('robustness', 0) && r.get('sessions', 0) == g.get('sessions', 0);
    }

    // ---- Accounts: anyone signed in, keyed by uid (Session 1, KIT-PLAN.md) ----

    function signedIn() { return request.auth != null; }
    function me(uid)    { return signedIn() && request.auth.uid == uid; }
    function invite(code) { return get(/databases/$(database)/documents/invites/$(code)).data; }

    // Readable one at a time by uid, never listed.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow create, update: if me(uid)
        && request.resource.data.keys().hasOnly(['name', 'photo', 'googlePhoto', 'createdAt', '_updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.get('photo', '').size() <= 60000;
      allow delete: if me(uid);
      // Yours alone: private/main (your live code), friends/<uid> (note, tags, met), guests/<id>.
      match /{sub}/{doc} {
        allow read, write: if me(uid) && sub in ['private', 'friends', 'guests'];
      }
    }

    // The QR's code. Anyone holding it may read who it's from. It dies after a day.
    match /invites/{code} {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'expires', '_updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.expires is timestamp
        && request.resource.data.expires <= request.time + duration.value(25, 'h');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // A friendship: one document for the pair, id "<lower uid>_<higher uid>". Made only by one
    // of the two, carrying the other's live code. Either may end it. Nobody edits it.
    // Either of the two may also ask whether it exists yet (uids never contain "_").
    match /friendships/{pair} {
      allow read: if signedIn() && (resource == null
        ? request.auth.uid in pair.split('_')
        : request.auth.uid in resource.data.uids);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uids', 'since', 'via', 'app', '_updatedAt'])
        && request.resource.data.uids.size() == 2
        && request.resource.data.uids[0] < request.resource.data.uids[1]
        && pair == request.resource.data.uids[0] + '_' + request.resource.data.uids[1]
        && request.auth.uid in request.resource.data.uids
        && invite(request.resource.data.via).uid in request.resource.data.uids
        && invite(request.resource.data.via).uid != request.auth.uid
        && invite(request.resource.data.via).expires > request.time;
      allow delete: if signedIn() && request.auth.uid in resource.data.uids;
    }

    // Nothing else is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

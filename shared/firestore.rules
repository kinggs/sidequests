rules_version = '2';

// One rule set for every app in this repo.
// Access = you are signed in with Google AND your email has a document in /members.
// The family list lives in Firestore, not in this file, so the apps can manage it:
// adding or removing a person (Fair Nine → Family) takes effect instantly, with no
// rules deploy and no email addresses in the public repo.

service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email));
    }

    // The allowlist itself: any family member can manage it.
    match /members/{email} {
      allow read, write: if isFamily();
    }

    // Every app keeps its data under /sidequests/<appId>/...
    match /sidequests/{appId}/{document=**} {
      allow read, write: if isFamily();
    }

    // Nothing else is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
